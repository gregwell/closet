---
import Layout from "@/layouts/Layout.astro";
import OrderForm from "@/components/orders/OrderForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="New order">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        New order
      </h1>
      <OrderForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        <a href="/orders" class="text-purple-300 hover:underline">Back to orders</a>
      </p>
    </div>
  </div>
</Layout>
