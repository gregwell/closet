---
import { getAvailableTransitions } from "@/lib/services/order-status";
import type { Order, OrderItem, OrderStatus, ProductStatus } from "@/types";

interface Props {
  order: Order;
  items: OrderItem[];
  status: OrderStatus;
  statusLabels: Record<ProductStatus, string>;
  orderStatusLabels: Record<OrderStatus, string>;
}

const { order, items, status, statusLabels, orderStatusLabels } = Astro.props;
---

<div class="rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl">
  <div class="mb-3 flex items-center justify-between">
    <div>
      <p class="font-semibold">{order.store}</p>
      <p class="text-xs text-blue-100/50">{order.orderDate}</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="rounded-full bg-purple-500/20 px-3 py-1 text-xs font-medium">{orderStatusLabels[status]}</span>
      <form
        method="POST"
        action="/api/orders/delete"
        onsubmit="return confirm('Delete this order and all its products? This cannot be undone.')"
      >
        <input type="hidden" name="orderId" value={order.id} />
        <button
          type="submit"
          class="rounded-md border border-red-500/30 px-2 py-1 text-xs text-red-300 transition-colors hover:bg-red-900/30"
        >
          Delete
        </button>
      </form>
    </div>
  </div>
  <div class="space-y-2">
    {
      items.map((item) => (
        <div class="rounded-lg bg-white/5 px-3 py-2 text-sm">
          <div class="flex items-center justify-between gap-2">
            <div>
              <span class="font-medium">{item.brand}</span> · {item.type} · {(item.priceCents / 100).toFixed(2)}
            </div>
            <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-medium whitespace-nowrap">
              {statusLabels[item.status]}
            </span>
          </div>
          {getAvailableTransitions(item.status).length > 0 && (
            <div class="mt-2 flex flex-wrap items-center gap-2">
              <span class="text-xs text-blue-100/40">Change to:</span>
              {getAvailableTransitions(item.status).map((next) => (
                <form method="POST" action="/api/orders/items/status">
                  <input type="hidden" name="itemId" value={item.id} />
                  <input type="hidden" name="newStatus" value={next} />
                  <button
                    type="submit"
                    class="rounded-md border border-white/20 px-2 py-1 text-xs text-blue-100/70 transition-colors hover:bg-white/10 hover:text-white"
                  >
                    {statusLabels[next]}
                  </button>
                </form>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>
</div>
